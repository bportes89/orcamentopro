# Supabase — copie este arquivo para .env e preencha com os dados do seu projeto.
# As variáveis EXPO_PUBLIC_* são embutidas no bundle e ficam visíveis no app;
# use sempre a anon key (RLS protege os dados), nunca a service role key.

EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_sua_anon_key

# Observabilidade — preencha para habilitar Sentry e PostHog.
# Use a anon key do projeto (ph_project_token) no PostHog.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat — chaves públicas do projeto (podem ir no bundle).
# Entitlement: pro | Produto mensal: orcamento_pro_mensal
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Segredos da Edge Function revenuecat-webhook (NÃO usar EXPO_PUBLIC_*):
# REVENUECAT_WEBHOOK_SECRET=<valor do header Authorization configurado no RevenueCat>
# REVENUECAT_WEBHOOK_SIGNING_SECRET=<opcional, segredo de assinatura HMAC>
